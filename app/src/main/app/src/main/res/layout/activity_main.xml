<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:padding="24dp" android:background="#0a0a0a">

    <Button android:id="@+id/btnGrant"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="1. Разрешить поверх экрана"
        android:backgroundTint="#ff3b3b" android:textColor="#fff"/>

    <Button android:id="@+id/btnStart"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="2. Заблокировать телефон"
        android:backgroundTint="#ff3b3b" android:textColor="#fff"/>
</LinearLayout>
